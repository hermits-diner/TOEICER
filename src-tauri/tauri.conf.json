{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TOEICER",
  "version": "0.1.0",
  "identifier": "com.toeicer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:17420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TOEICER",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Korean",
          "English"
        ]
      }
    },
    "shortDescription": "TOEIC Listening & Reading 문제 풀이",
    "fileAssociations": [
      {
        "ext": [
          "toic"
        ],
        "name": "TOEICER 문제 세트",
        "description": "TOEIC Listening & Reading 문제 세트",
        "role": "Viewer",
        "mimeType": "application/x-toeicer-set"
      }
    ]
  }
}
