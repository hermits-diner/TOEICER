{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TOEICER Studio",
  "identifier": "com.toeicer.studio",
  "build": {
    "beforeDevCommand": "npm run dev:studio",
    "beforeBuildCommand": "npm run build:studio"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TOEICER Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "shortDescription": "TOEIC Listening & Reading 문제 출제·풀이",
    "fileAssociations": [
      {
        "ext": [
          "toic"
        ],
        "name": "TOEICER 문제 세트",
        "description": "TOEIC Listening & Reading 문제 세트",
        "role": "Editor",
        "mimeType": "application/x-toeicer-set"
      }
    ]
  }
}
