{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "moduTOEIC Studio",
  "identifier": "com.toeicer.studio",
  "build": {
    "beforeDevCommand": "npm run dev:studio",
    "beforeBuildCommand": "npm run build:studio"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "moduTOEIC Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://exam-market.hermitsdiner.workers.dev/updates/toeic/studio/latest.json"
      ]
    }
  },
  "bundle": {
    "shortDescription": "TOEIC Listening & Reading 문제 출제·풀이",
    "fileAssociations": [
      {
        "ext": [
          "toic"
        ],
        "name": "moduTOEIC 문제 세트",
        "description": "TOEIC Listening & Reading 문제 세트",
        "role": "Editor",
        "mimeType": "application/x-toeicer-set"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks-studio.nsh"
      }
    }
  }
}
